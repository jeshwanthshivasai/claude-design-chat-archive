{
  "manifest_version": 3,
  "name": "Design Chat Archive",
  "short_name": "Chat Archive",
  "version": "1.0.1",
  "description": "Export your Claude Design chats to Markdown before the site closes on 14 Dec 2026. Unofficial; nothing leaves your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Design Chat Archive",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/design*"
      ],
      "js": [
        "src/zip.js",
        "src/render.js",
        "src/exporter.js",
        "src/panel.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
