{
  "manifest_version": 3,
  "name": "Design Chat Archive",
  "short_name": "Chat Archive",
  "version": "2.0.0",
  "description": "Unofficial. Saves your Claude Design chats before 14 Dec 2026, plus case studies and a search reader. Nothing leaves your browser.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Design Chat Archive",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/design*"
      ],
      "js": [
        "src/zip.js",
        "src/render.js",
        "src/exporter.js",
        "src/insights.js",
        "src/casestudy.js",
        "src/wrapped.js",
        "src/viewer.js",
        "src/pipeline.js",
        "src/bridge.js",
        "src/savebtn.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
