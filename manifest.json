{
  "manifest_version": 3,
  "name": "Chat Archive for Claude Design (unofficial)",
  "short_name": "Chat Archive",
  "version": "1.0.1",
  "description": "Export every conversation from your Claude Design projects to Markdown and JSON before the standalone site closes. Runs locally; no data leaves your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Chat Archive for Claude Design",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/design*"],
      "js": ["src/zip.js", "src/render.js", "src/exporter.js", "src/panel.js"],
      "run_at": "document_idle"
    }
  ]
}
